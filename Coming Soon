<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coming Soon - Georgia Statewide Mesh Coalition</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden;
        }
        .vanta-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }
    </style>
</head>
<body class="bg-indigo-900 text-white">
    <div id="vanta-background" class="vanta-container"></div>
    
    <div class="flex flex-col justify-center items-center h-screen px-4 text-center">
        <div class="max-w-2xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-bold mb-6 text-green-300 animate-pulse">
                Please pardon our progress!
            </h1>
            <p class="text-xl md:text-2xl mb-10 text-green-200">
                Come back soon for exciting Growth!
            </p>
            <div class="border-t border-green-400 w-1/2 mx-auto my-8"></div>
            <p class="text-lg md:text-xl text-green-100">
                Georgia Statewide Mesh Coalition
            </p>
            <p class="text-lg md:text-xl text-green-100">
                We'll be Meshing with you soon enough.
            </p>
        </div>
    </div>

    <script>
        VANTA.NET({
            el: "#vanta-background",
            mouseControls: false,
            touchControls: false,
            gyroControls: false,
            minHeight: 200.00,
            minWidth: 200.00,
            scale: 1.00,
            scaleMobile: 1.00,
            color: 0x22c55e,
            backgroundColor: 0x1e3a8a,
            points: 12.00,
            maxDistance: 24.00,
            spacing: 16.00
        })
    </script>
</body>
</html>
