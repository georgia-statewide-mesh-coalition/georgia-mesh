                                </div>
                            </div>

                            <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
                                <label for="bandwidth" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                                    Bandwidth Allocation
                                </label>
                                <div class="mt-1 sm:mt-0 sm:col-span-2">
                                    <select id="bandwidth" name="bandwidth" class="max-w-lg block focus:ring-primary focus:border-primary w-full shadow-sm sm:max-w-xs sm:text-sm border-gray-300 rounded-md">
                                        <option>10%</option>
                                        <option>25%</option>
                                        <option selected>50%</option>
                                        <option>75%</option>
                                        <option>100%</option>
                                    </select>
                                    <p class="mt-2 text-sm text-gray-500">How much of your bandwidth to share with the mesh.</p>
                                </div>
                            </div>
