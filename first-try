                                    </div>
                                </div>
                            </div>

                            <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
                                <label for="channel" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                                    Wireless Channel
                                </label>
                                <div class="mt-1 sm:mt-0 sm:col-span-2">
                                    <select id="channel" name="channel" class="max-w-lg block focus:ring-primary focus:border-primary w-full shadow-sm sm:max-w-xs sm:text-sm border-gray-300 rounded-md">
                                        <option>1 (2.412 GHz)</option>
                                        <option selected>6 (2.437 GHz)</option>
                                        <option>11 (2.462 GHz)</option>
                                        <option>36 (5.180 GHz)</option>
                                        <option>149 (5.745 GHz)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
                                <label for="encryption" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                                    Encryption
                                </label>
                                <div class="mt-1 sm:mt-0 sm:col-span-2">
                                    <select id="encryption" name="encryption" class="max-w-lg block focus:ring-primary focus:border-primary w-full shadow-sm sm:max-w-xs sm:text-sm border-gray-300 rounded-md">
                                        <option>WPA3 Personal</option>
                                        <option selected>WPA2/WPA3 Personal</option>
                                        <option>WPA2 Personal</option>
                                        <option>None (Open)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start sm:border-t sm:border-gray-200 sm:pt-5">
                                <label for="password" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                                    Network Password
                                </label>
                                <div class="mt-1 sm:mt-0 sm:col-span-2">
